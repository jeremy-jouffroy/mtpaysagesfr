---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { img, imgAlt } from '../scripts/utils';

// Ajouter un projet : déposer la photo dans public/images/, la déclarer dans src/data/photos.ts, puis l'ajouter ici.
// Une photo avant/après par projet fonctionne le mieux.
const projects = [
  { cat: 'creation', title: 'Terrain de pétanque et terrasse bois', img: 'creation-terrain-petanque-terrasse-bois-avant-apres.webp' },
  { cat: 'entretien', title: 'Taille d’arbustes en boule', img: 'taille-arbustes-en-boule-entretien-jardin-avant-apres.webp' },
  { cat: 'creation', title: 'Massif d’arbustes et paillage minéral', img: 'creation-massif-arbustes-paillage-mineral-avant-apres.webp' },
  { cat: 'entretien', title: 'Débroussaillage de la cour d’un corps de ferme', img: 'debroussaillage-nettoyage-cour-corps-de-ferme-avant-apres.webp' },
  { cat: 'creation', title: 'Terrasse en carrelage extérieur', img: 'creation-terrasse-carrelage-exterieur-avant-apres.webp' },
  { cat: 'entretien', title: 'Taille en nuage (niwaki) d’un genévrier', img: 'taille-niwaki-genevrier-en-nuage-avant-apres.webp' },
  { cat: 'creation', title: 'Création d’une pelouse', img: 'avant-apres-creation-pelouse-gazon-jardin-saulon-la-rue.webp' },
  { cat: 'entretien', title: 'Désherbage d’une cour dallée avec puits', img: 'desherbage-nettoyage-cour-dallee-puits-avant-apres.webp' },
  { cat: 'creation', title: 'Plantation d’un grand olivier', img: 'plantation-grand-olivier-jardin-piscine-paysagiste.webp' },
  { cat: 'entretien', title: 'Remise en état d’une allée gravillonnée', img: 'debroussaillage-allee-gravier-jardin-avant-apres.webp' },
  { cat: 'creation', title: 'Semis de gazon et massifs paillés', img: 'semis-gazon-massifs-arbustes-paillage-mineral-avant-apres.webp' },
  { cat: 'entretien', title: 'Arrachage d’une haie de thuyas', img: 'arrachage-haie-thuyas-nettoyage-jardin-avant-apres.webp' },
  { cat: 'creation', title: 'Allée en pas japonais', img: 'allee-pas-japonais-dalles-pelouse-jardin.webp' },
  { cat: 'entretien', title: 'Espaces verts d’une aire de jeux (collectivité)', img: 'entretien-espaces-verts-aire-de-jeux-collectivite.webp' },
  { cat: 'creation', title: 'Plantation d’arbres tuteurés', img: 'plantation-arbres-tuteurage-jardin-paysagiste.webp' },
];
const filters = [
  { key: 'all', label: 'Tout' },
  { key: 'entretien', label: 'Entretien' },
  { key: 'creation', label: 'Création' },
  { key: 'elagage', label: 'Élagage' },
].filter((f) => f.key === 'all' || projects.some((p) => p.cat === f.key));
---
<Base title="Nos réalisations" description="Découvrez nos chantiers d'entretien et de création de jardins en photos avant / après.">
  <PageHero title="Nos réalisations" lead="Quelques jardins que nous avons entretenus, transformés ou créés. La plupart sont photographiés avant et après notre passage." />
  <section class="section">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrer les réalisations">
        {filters.map((f, i) => <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
      <div class="gallery" id="gallery">
        {projects.map((p) => (
          <figure data-cat={p.cat}>
            <img src={img(p.img)} alt={imgAlt(p.img)} loading="lazy" width="600" height="600" />
            <figcaption><strong>{p.title}</strong></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="Envie du même résultat chez vous ?" />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('#gallery figure');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((it) => (it.hidden = f !== 'all' && it.dataset.cat !== f));
    }),
  );
</script>
