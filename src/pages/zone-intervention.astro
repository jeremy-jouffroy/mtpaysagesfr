---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { url, slugify } from '../scripts/utils';

const bands = [5, 10, 15, 20].map((max, i, all) => ({
  label: i === 0 ? `Moins de ${max} km` : `De ${all[i - 1]} à ${max} km`,
  communes: site.communes.filter((c) => c.km <= max && (i === 0 || c.km > all[i - 1])),
}));
---
<Base title={`Zone d’intervention : ${site.address.city} et alentours`} description={`MT Paysages intervient à ${site.address.city} et dans un rayon de ${site.radiusKm} km : ${site.communes.slice(0, 6).map((c) => c.name).join(', ')}…`}>
  <PageHero title="Zone d’intervention" lead={`Nous intervenons à ${site.address.city} et dans toutes les communes situées à environ ${site.radiusKm} km.`} />
  <section class="section">
    <div class="container grid grid-2">
      <div>
        <h2>Communes desservies</h2>
        {bands.map((b) => (
          <>
            <h3 style="margin-top:1.5rem">{b.label} de {site.address.city}</h3>
            <ul class="communes">
              {b.communes.map((c) => <li>📍 {c.name}</li>)}
            </ul>
          </>
        ))}
        {site.cityPages.length > 0 && (
          <>
            <h3 style="margin-top:2rem">Pages par commune</h3>
            <ul>
              {site.cityPages.map((c) => <li><a href={url(`jardinier-${slugify(c.name)}/`)}>Jardinier paysagiste à {c.name}</a></li>)}
            </ul>
          </>
        )}
        <p class="muted">Votre commune n’est pas dans la liste ? <a href={url('contact/')}>Contactez-nous</a> : nous étudions chaque demande.</p>
      </div>
      <!-- Carte générée à partir des coordonnées geo.api.gouv.fr (public/images/carte-zone-intervention-saulon-la-rue.svg). -->
      <img src={url('images/carte-zone-intervention-saulon-la-rue.svg')} alt={`Carte de la zone d’intervention : ${site.radiusKm} km autour de ${site.address.city}, de Dijon à Nuits-Saint-Georges et Genlis`} width="700" height="600" style="border-radius:var(--radius)" />
    </div>
  </section>
  <CtaBand />
</Base>
