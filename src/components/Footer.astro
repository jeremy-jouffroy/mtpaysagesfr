---
import { site } from '../config/site';
import { byCategory } from '../data/services';
import { url, telHref } from '../scripts/utils';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h3>{site.name}</h3>
        <p>
          {site.address.street && <>{site.address.street}<br /></>}
          {site.address.postalCode} {site.address.city}
        </p>
        <p>
          <a href={telHref(site.phone)}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="small">{site.hours}</p>
        <ul class="social">
          <li><a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1C2.6 9.9 2.6 10.2 2.6 12s0 2.1.1 3.3c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z"/></svg></a></li>
          <li><a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg></a></li>
          <li><a href={site.googleReviewsUrl} target="_blank" rel="noopener" aria-label="Fiche Google Maps"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg></a></li>
        </ul>
      </div>
      <div>
        <h3>Entretien</h3>
        <ul>
          {byCategory('entretien').map((s) => <li><a href={url(`entretien-jardin/${s.slug}/`)}>{s.title}</a></li>)}
          <li><a href={url('contrats-entretien/')}>Contrats d’entretien</a></li>
        </ul>
      </div>
      <div>
        <h3>Création</h3>
        <ul>
          {byCategory('creation').map((s) => <li><a href={url(`creation-amenagement/${s.slug}/`)}>{s.title}</a></li>)}
          <li><a href={url('elagage-abattage/')}>Élagage et abattage</a></li>
        </ul>
      </div>
      <div>
        <h3>L’entreprise</h3>
        <ul>
          <li><a href={url('a-propos/')}>Qui sommes-nous</a></li>
          <li><a href={url('realisations/')}>Réalisations</a></li>
          <li><a href={url('avis/')}>Avis clients</a></li>
          <li><a href={url('zone-intervention/')}>Zone d’intervention</a></li>
          <li><a href={url('credit-impot-50/')}>Crédit d’impôt 50 %</a></li>
          <li><a href={url('conseils/')}>Conseils jardin</a></li>
          <li><a href={url('devis/')}>Demander un devis</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {site.legal.companyName} · SIRET {site.legal.siret}
        {site.sap.enabled && <> · Déclaration SAP n° {site.sap.number}</>}
      </p>
      <ul>
        <li><a href={url('mentions-legales/')}>Mentions légales</a></li>
        <li><a href={url('confidentialite/')}>Confidentialité</a></li>
        <li><a href={url('cgv/')}>CGV</a></li>
      </ul>
    </div>
  </div>
</footer>
