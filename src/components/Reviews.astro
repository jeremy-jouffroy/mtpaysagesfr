---
import { site } from '../config/site';

interface Props { count?: number }
const { count = 3 } = Astro.props;
// TODO : remplacer par de vrais avis Google copiés avec l'accord des clients (prénom + initiale).
// Ne jamais inventer d'avis : c'est une pratique commerciale trompeuse.
const reviews = Array.from({ length: count }, (_, i) => ({
  text: `[Copier ici le texte d’un avis Google réel n° ${i + 1}]`,
  author: '[Prénom N.]',
  place: '[Commune]',
}));
---
<div class="grid grid-3">
  {reviews.map((r) => (
    <figure class="review">
      <div class="stars" aria-label="5 étoiles sur 5">★★★★★</div>
      <blockquote>{r.text}</blockquote>
      <figcaption class="small muted">{r.author} · {r.place}</figcaption>
    </figure>
  ))}
</div>
<p style="margin-top:1.5rem">
  <a class="btn btn--outline" href={site.googleReviewsUrl} target="_blank" rel="noopener">Voir tous les avis sur Google</a>
</p>
