---
import { site } from '../config/site';
import { reviews } from '../data/reviews';

interface Props { count?: number }
const { count = 3 } = Astro.props;
const shown = reviews.slice(0, count);
---
<div class="grid grid-3">
  {shown.map((r) => (
    <figure class="review">
      <div class="stars" aria-label={`${r.rating} étoiles sur 5`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
      <blockquote>{r.text.split('\n').map((line) => <p>{line}</p>)}</blockquote>
      <figcaption class="small muted">{r.author} · avis Google, {r.date}</figcaption>
    </figure>
  ))}
</div>
<p style="margin-top:1.5rem">
  <a class="btn btn--outline" href={site.googleReviewsUrl} target="_blank" rel="noopener">Voir tous les avis sur Google</a>
</p>
