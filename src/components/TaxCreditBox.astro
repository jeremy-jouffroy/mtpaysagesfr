---
import { site } from '../config/site';
import { url } from '../scripts/utils';
---
{site.sap.enabled && (
  <div class="tax-box">
    <div class="big">-50 %</div>
    <p><strong>de crédit d’impôt sur l’entretien de votre jardin</strong></p>
    <p class="small muted">
      {site.sap.avanceImmediate
        ? 'Avec l’avance immédiate de l’URSSAF, vous ne payez que la moitié de la facture.'
        : 'La moitié de vos dépenses vous est remboursée par les impôts.'}{' '}
      Plafond : 5 000 € de dépenses par an et par foyer.
    </p>
    <a href={url('credit-impot-50/')}>Comment ça marche →</a>
  </div>
)}
