---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { url, telHref } from '../scripts/utils';
import type { Faq } from '../data/services';

interface Props {
  title: string;
  description?: string;
  image?: string;
  faq?: Faq[];
  noindex?: boolean;
}

const { title, description = site.description, image, faq, noindex = false } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL(url('/'), Astro.site).href + '#entreprise',
  name: site.name,
  description: site.description,
  url: new URL(url('/'), Astro.site).href,
  telephone: telHref(site.phone).replace('tel:', ''),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: 'FR',
  },
  areaServed: site.communes.map((name) => ({ '@type': 'City', name })),
  openingHours: site.openingHoursSpec,
  priceRange: '€€',
  ...(site.googleRating && {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: site.googleRating.value, reviewCount: site.googleRating.count },
  }),
};

const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#1f3a1d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body>
    <a href="#contenu" class="visually-hidden">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <div class="mobile-bar">
      <a class="btn btn--outline" href={telHref(site.phone)}>📞 Appeler</a>
      <a class="btn btn--primary" href={url('devis/')}>Devis gratuit</a>
    </div>
  </body>
</html>
